# Local SQLite file (default: finanzas.db at the repo root)
FINANZAS_DB=

# Turso remote — when both are set, these override FINANZAS_DB
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Single-user auth passphrase — when set, every /api/v1 endpoint requires
# login. With NODE_ENV=production a missing or <12-character value refuses
# to start (fail-closed).
FINANZAS_AUTH_PASSPHRASE=
